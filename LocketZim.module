[Script]
zim_revenuecat_request = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/v1\/(?:receipts|subscribers\/[^/?]+)(?:\?|$), script-path=https://raw.githubusercontent.com/zim1st/locketzim/main/scripts/revenuecat-41b89bdaed96.js, timeout=10
zim_revenuecat_response = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/v1\/(?:receipts|subscribers\/[^/?]+)(?:\?|$), script-path=https://raw.githubusercontent.com/zim1st/locketzim/main/scripts/revenuecat-41b89bdaed96.js, requires-body=true, max-size=0, timeout=10
zim_remote_config_request = type=http-request, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/namespaces\/[^/?]+:fetch(?:\?|$), script-path=https://raw.githubusercontent.com/zim1st/locketzim/main/scripts/remote-config-7229b24af28f.js, timeout=10
zim_remote_config_response = type=http-response, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/namespaces\/[^/?]+:fetch(?:\?|$), script-path=https://raw.githubusercontent.com/zim1st/locketzim/main/scripts/remote-config-7229b24af28f.js, requires-body=true, max-size=0, timeout=10

[MITM]
hostname = %APPEND% api.revenuecat.com, firebaseremoteconfig.googleapis.com
